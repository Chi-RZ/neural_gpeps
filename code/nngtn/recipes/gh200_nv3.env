# Kernel recipe: float64 contraction, every card (nngtn.recipe applies it).
export PIVOTED_PANEL=16
export PIVOTED_SEARCH_WINDOW=1
export PIVOTED_LEAF_CUTOFF=0
export NNGTN_NVCC_FLAGS='-DPIVOTED_GLIVE=7 -DPIVOTED_BSELECT_WARP=1 -DPIVOTED_WARP_COMPACT=24 -DPIVOTED_BLOCK_THREADS=256 -DPIVOTED_BLOCK_COMPACT=0 -DPIVOTED_GFWD_THREADS=512 -DPIVOTED_WPB=2 -DPIVOTED_BWD_WORK=25 -DPIVOTED_BLOCK_MINBLOCKS=3 -DPIVOTED_GUU=1 -DPIVOTED_GBWD_LIVE=1 -DPIVOTED_BWD_MINBLOCKS=3 -DPIVOTED_GBWD_MINBLOCKS=2'
export PIVOTED_GLOBAL_BWD_FROM=176
export PIVOTED_GBWD_PANEL=8
