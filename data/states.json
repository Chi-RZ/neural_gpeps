  "weights": "equinox leaves of nngtn.build_model(Lx, Ly, nv=...) (trunk then head), float32",
  "projection": "quantax Flip(axis=0) @ Flip(axis=1) @ SpinInverse(), trivial sector, 8 images",
  "energies": "per site; errors are one standard error (largest block-jackknife error)"
 },
